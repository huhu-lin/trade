# Copy to .env for local testing. In the cloud these come from GitHub Secrets.

# FinMind (Taiwan data) — register free at https://finmindtrade.com to raise rate limit to 1500/hr
FINMIND_TOKEN=

# SEC EDGAR requires a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT=Your Name your-email@example.com

# Claude analysis layer
ANTHROPIC_API_KEY=
TRADE_ANALYST_MODEL=claude-opus-4-8

# Notification (set ONE of the following channels)
DISCORD_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
